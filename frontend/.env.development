# Must be the SAME HOST the dev page is served from, not just the same machine.
# Cookies are scoped by host and ignore port, so ws://localhost:8413 gets the
# session cookie from a page on http://localhost:5173 — but ws://127.0.0.1:8413
# does not, and the backend then closes the socket with 4401 (unauthenticated).
# Set explicitly rather than derived from window.location because the Vite dev
# proxy does not forward the /api WebSocket upgrade.
VITE_SOCKET_URL=ws://localhost:8413/api
